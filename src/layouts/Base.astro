---
import '../styles/global.css';
import { site, socials } from '../data/site';
interface Props { title?: string; description?: string; }
const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta name="color-scheme" content="light dark" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;700&family=Young+Serif&display=swap" rel="stylesheet" />
  <script is:inline>
    try {
      var t = localStorage.getItem('theme');
      if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = t;
    } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <a class="mark" href="/">Basil Ugochukwu</a>
    <nav aria-label="Primary">
      <a href="/#work">Work</a><a href="/#screen">Stage and screen</a><a href="/#about">About</a><a href="/#contact">Contact</a>
    </nav>
    <button id="theme" type="button" aria-label="Switch colour theme">Theme</button>
  </header>
  <main id="main"><slot /></main>
  <footer class="foot">
    <p>&copy; {new Date().getFullYear()} {site.name}</p>
    <ul>{socials.map((s) => <li><a href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>)}</ul>
  </footer>
  <script is:inline>
    document.getElementById('theme').addEventListener('click', function () {
      var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  </script>
</body>
</html>
